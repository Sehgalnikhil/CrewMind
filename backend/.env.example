# Copy to .env and fill in.

# Required for agents to function — get one at https://aistudio.google.com/
GEMINI_API_KEY=

JWT_SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./crewmind.db
CORS_ORIGINS=["http://localhost:5173"]

# OAuth Integrations
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
